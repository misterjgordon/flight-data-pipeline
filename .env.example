# Databricks workspace
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-databricks-pat-for-claude-mcp>

# Streamlit app — read-only token for flight-map queries
# Generate at: Settings → Developer → Access tokens
STREAMLIT_CLOUD_READONLY_TOKEN=<your-streamlit-readonly-pat>
DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>
